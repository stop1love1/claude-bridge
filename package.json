{
  "name": "claude-bridge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --import tsx scripts/run.ts development node --import tsx ./scripts/bridge-http-server.ts",
    "build": "next build",
    "start": "node --import tsx scripts/run.ts production node --import tsx ./scripts/bridge-http-server.ts",
    "serve": "next build && node --import tsx scripts/run.ts production node --import tsx ./scripts/bridge-http-server.ts",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "telegram:login": "node --import tsx scripts/telegram-login.ts",
    "set:password": "node --import tsx scripts/set-password.ts",
    "approve:login": "node --import tsx scripts/approve-login.ts"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.18.4",
    "lucide-react": "^1.9.0",
    "mermaid": "^11.17.2",
    "next": "16.3.3",
    "node-pty": "^1.0.0",
    "prism-react-renderer": "^2.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.5.0",
    "telegram": "^2.26.22",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bun": "latest",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.13",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vitest": "^2.1.8"
  }
}
